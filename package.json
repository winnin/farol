{
  "name": "@winninjs/farol",
  "version": "0.2.1",
  "description": "Tells code reviewers how much attention a pull request needs and where to look first: what the change reaches, a merge risk score and a review plan. TypeScript/React, Go and Python. Shadow mode: never blocks.",
  "keywords": [
    "code-review",
    "pull-request",
    "risk",
    "static-analysis",
    "github-action",
    "typescript",
    "react",
    "go",
    "python",
    "diff-coverage"
  ],
  "author": "Winnin",
  "homepage": "https://winnin.github.io/farol/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winnin/farol.git"
  },
  "bugs": {
    "url": "https://github.com/winnin/farol/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "farol": "dist/cli.js"
  },
  "files": [
    "dist",
    "go-helper",
    "py-helper",
    "!**/__pycache__",
    "!go-helper/gohelper"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/embed-assets.mjs && tsup",
    "assets": "node scripts/embed-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "commander": "15.0.0",
    "eslint": "10.13.0",
    "graphql": "16.11.0",
    "picomatch": "4.0.7",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
